@startuml

!$stylePath = "https://raw.githubusercontent.com/olek3/plantuml-includes/refs/heads/main/iuml"
!include $stylePath/reading.iuml

'skinparam backgroundcolor #191a1c

skinparam packagebordercolor #888

!$pos_int = 7
!$pos_frac = 3
!$part = 1
!$chapter = 5

legend $pos_int.$pos_frac% (Chapter $part/$chapter)

mainframe **characters** John Steinbeck //**East of Eden**//


(Salinas Valley) as salinas <<location>>

package Hamiltons {
    :I: <<narrator>>
    :Samuel: $male
    :Liza: $female

    :George: $male
    :Will: $male
    :Tom: $male

    :Mollie: $female

    :Joseph (Joe): as Joe $male

    George <-- Samuel : father
    Will <-- Samuel : father
    Tom --> Samuel : third son

    Samuel <- Mollie : daughter

    Samuel <-- Joe : fourth son
}

salinas <-- Hamiltons : came about 1870

I <- Samuel : grandfather


Samuel <-- Liza : wife

:Adam Trask: as Adam $male
:Cyrus: $male

Adam -- salinas
Cyrus --> Adam : father

' жена Сайруса 
:Mrs. Trask: as mrsTrask <<unnamed>><<dead>> $female

mrsTrask --> Adam : mother

:Alice: $female


:Charles: $male

Alice --> Charles : mother
Alice --> Cyrus : 2<sup>nd</sup> wife

Charles --> Adam : brother

mrsTrask -> Cyrus : 1<sup>st</sup> wife

(Thornes) <<group>>
(Delmars) <<group>>

salinas -- Thornes
salinas -- Delmars

@enduml