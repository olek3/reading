@startuml

!$stylePath = "https://raw.githubusercontent.com/olek3/plantuml-includes/refs/heads/main/iuml"
!include $stylePath/reading.iuml

'skinparam backgroundcolor #191a1c

skinparam packagebordercolor #888

!$pos_int = 8
!$pos_frac = 8
!$part = 1
!$chapter = 6

legend $pos_int.$pos_frac% (Chapter $part/$chapter)

mainframe **characters** John Steinbeck //**East of Eden**//


(Salinas Valley) as salinas <<location>>

package Hamiltons {
    :I: <<narrator>>
    :Samuel: $male
    :Liza: $female

    :George: $male
    :Will: $male
    :Tom: $male

    :Mollie: $female

    :Joseph (Joe): as Joe $male

    :Una: $female
    :Lizzie: $female
    :Dessie: $female
    :Olive: $female

    George <-- Samuel : father
    Will <-- Samuel : father
    Tom --> Samuel : third son

    Samuel <- Mollie : daughter

    Samuel <--- Joe : fourth son

    Lizzie ---> Samuel : daughter
    Dessie ---> Samuel : daughter

    Samuel <--- Una : daughter
    Samuel <-- Olive : daughter

    I <-- Olive : mother
}

salinas <-- Hamiltons : came about 1870

I <- Samuel : grandfather


Samuel <-- Liza : wife

:Adam Trask: as Adam $male
:Cyrus: $male

Adam -- salinas
Cyrus --> Adam : father

' жена Сайруса 
:Mrs. Trask: as mrsTrask <<unnamed>><<dead>> $female

mrsTrask --> Adam : mother

:Alice: $female


:Charles: $male

Alice --> Charles : mother
Alice --> Cyrus : 2<sup>nd</sup> wife

Charles --> Adam : brother

mrsTrask -> Cyrus : 1<sup>st</sup> wife

(Thornes) <<group>>
(Delmars) <<group>>

salinas -- Thornes
salinas -- Delmars

:Mr Hallam: as innkeeper $male

innkeeper -- salinas : the innkeeper

:Edwards: $male

Edwards --> innkeeper : whoremaster

(Niagara Falls) as falls <<location>>

Adam -- falls : visited on way home

:"Cat": as cat $male
:Mrs May: as mrsMay

falls -- cat : bartender
falls -- mrsMay : boarding house

@enduml